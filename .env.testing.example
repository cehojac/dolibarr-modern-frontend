# Entorno de pruebas E2E con Playwright
# Copia este archivo a .env.testing.
# E2E_USER_LOGIN / E2E_USER_PASSWORD deben coincidir con el usuario de prueba
# creado por el seed del Dolibarr de Docker (ver docker/dolibarr-test/seed).
# No son credenciales reales de producción.

E2E_BASE_URL=http://localhost:8000
E2E_USER_LOGIN=e2e_test_user
E2E_USER_PASSWORD=e2e_test_password

# Mailtrap (captura de emails de prueba; no se usa todavía en los tests)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=
