# Credenciales del Dolibarr de test (Docker). Solo para uso local.
# Copia a .env.docker-test si quieres sobreescribir docker-compose.yml con variables,
# o úsalo como referencia rápida de las credenciales por defecto.

DOLI_ADMIN_LOGIN=admin
DOLI_ADMIN_PASSWORD=admin_test_pw
DOLI_URL_ROOT=http://localhost:8080

# Rellenar tras generar la clave API en el admin de Dolibarr (Inicio > Configuración > Módulos > API > Claves)
DOLIBARR_TEST_API_KEY=

# Usuario E2E que crea el script de seed (scripts/seed-dolibarr.mjs)
E2E_TEST_USER_LOGIN=e2e_test_user
E2E_TEST_USER_PASSWORD=e2e_test_password
